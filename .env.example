# Pikafish executable and NNUE network paths.
# Copy to .env.local, then load these variables in your shell.
PIKAFISH_PATH=C:\workspace\Pikafish.2026-01-02\Windows\pikafish-avx2.exe
PIKAFISH_NNUE_PATH=C:\workspace\Pikafish.2026-01-02\pikafish.nnue
PIKAFISH_MOVE_TIME_MS=1000
# MCTS parameters
MCTS_BATCH_SIZE=32
MCTS_POLICY_TEMPERATURE=1.25
MCTS_EXPLORATION=1.25
MCTS_Q_GUARD_MIN_VISITS=25
MCTS_Q_GUARD_MIN_GAP=0.15
MCTS_TIMING_LOG=1
# Background benchmark result directory. Defaults to benchmark/.
BENCHMARK_PATH=benchmark